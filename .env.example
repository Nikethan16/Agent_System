# Copy to .env and fill in only the providers you actually use.
# LiteLLM reads these automatically based on the model prefix.
# NEVER commit a filled-in .env — it is git-ignored for a reason.

# ---- SECURITY (set these before exposing the app off localhost) ------------
# Shared access token. If set, EVERY API request + WebSocket must present it
# (Authorization: Bearer <token>, X-Auth-Token header, or ?token= for the WS).
# If UNSET, the API only answers loopback (127.0.0.1) and refuses other hosts —
# so the app can't be deployed wide-open by accident. Generate a long random value.
# AGENT_AUTH_TOKEN=
# Disable the arbitrary-shell tool. The workspace cwd is NOT real containment, so
# turn this on (=1) in any networked deployment and run shell only in a real sandbox.
# AGENT_DISABLE_BASH=1
# Real shell sandbox: set a Docker image to run every run_bash INSIDE an ephemeral
# container (only the workspace mounted). Required to enable bash — the host-shell
# fallback has been removed. Build or pull an ARM-compatible image for the Oracle VM.
# AGENT_BASH_DOCKER_IMAGE=python:3.11-slim
#   RECOMMENDED: build the preloaded verify image (python+node+pytest+common deps baked
#   in) so the agent's verify loop can actually run a test suite with NO network egress:
#       ./docker/build-verify-image.sh   ->   AGENT_BASH_DOCKER_IMAGE=agent-verify:latest
# Docker sandbox resource limits (all optional — these are the defaults):
# AGENT_BASH_DOCKER_TIMEOUT=120       # wall-clock timeout (seconds)
# AGENT_BASH_DOCKER_MEMORY=512m       # container memory cap
# AGENT_BASH_DOCKER_CPUS=1.0          # CPU quota
# AGENT_BASH_DOCKER_NETWORK=none      # NO egress (secure default). With the preloaded
#                                     # agent-verify image, tests run offline. Use 'bridge'
#                                     # ONLY for the rare run that needs a fresh pip/npm install.
# AGENT_BASH_DOCKER_PIDS=64           # max processes in the container
# Hard server-side ceilings a client can never exceed (clamps max_usd/max_iterations).
# AGENT_MAX_USD_CEILING=5.0
# AGENT_MAX_ITER_CEILING=60

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# FREE / low-cost providers the cost-first selector will auto-use once their key is set:
#   NVIDIA NIM — free for dev (~40 req/min PER KEY), get a key at https://build.nvidia.com
# NVIDIA_NIM_API_KEY=
#   KEY POOL: add more free accounts' keys as _1, _2, … and the app spreads calls
#   across all of them (least-loaded scheduling) so effective RPM scales: 4 keys ≈ 160/min.
#   Works for ANY provider (e.g. GEMINI_API_KEY_1) — the base var + _1.._20 are pooled.
# NVIDIA_NIM_API_KEY_1=
# NVIDIA_NIM_API_KEY_2=
# NVIDIA_NIM_API_KEY_3=
#   Local Ollama — set this to 1 (and run Ollama) to allow local free models
# USE_OLLAMA=1

# ---- RESILIENCE (key pool + fallback; sane defaults, all optional) ----------
# Per-call wall-clock timeout in seconds (bounds a stuck/cold-start provider).
# AGENT_LLM_TIMEOUT=90
# Per-key requests/minute ceiling the pool paces to (NVIDIA NIM free ≈ 40).
# AGENT_KEY_RPM=40
# Seconds a key sits out after a rate-limit/error before it's retried.
# AGENT_KEY_COOLDOWN=20
# Max seconds the pool will pace-wait for a free key before using the least-loaded one.
# AGENT_KEY_MAX_WAIT=8

# Optional: where agents read/write files (default ./workspace)
# AGENT_WORKSPACE=./workspace

# Optional: point at a different model config
# MODELS_CONFIG=./config/models.yaml

# ---- PLACEHOLDERS: fill these in to enable optional capabilities ----
# Research agent (web_search tool). Needs a search-provider key (e.g. Tavily/Serper).
# SEARCH_API_KEY=
# SEARCH_API_URL=https://api.tavily.com/search

# Image agent (generate_image tool). Set the image model in config/models.yaml
# (image_model:) and the matching provider key above (e.g. OPENAI_API_KEY for DALL·E).
# IMAGE_MODEL=dall-e-3

# Embedding-backed memory (optional; falls back to offline keyword recall).
# EMBED_MODEL=text-embedding-3-small      # + the matching provider key above
# Vector index backend for semantic recall (auto uses NumPy when available):
# MEMORY_VECTOR_BACKEND=auto   # auto | numpy | none

# Langfuse tracing (optional; local JSONL traces in data/traces/ work without it).
# With these set, every run gets a proper span tree: run → subagent → LLM generation
# with model name, prompt/completion tokens, cost, and latency per call.
# pip install langfuse  (then add these keys)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL

# GitHub integration (repo-engineer agent — clone, edit, push, PR)
# GITHUB_TOKEN=                    # Personal access token or fine-grained token

# Task queue: the built-in SQLite queue needs nothing. Redis is an optional upgrade.
# REDIS_URL=redis://localhost:6379/0

# Optional: where the app stores chats + per-session files (default ./data)
# DATA_DIR=./data
# Optional: audit log location (default ./audit.log)
# AUDIT_LOG=./audit.log

# Content-safety screening (optional): a model used by the safety_check tool to vet
# untrusted text (web pages). Falls back to a heuristic when unset.
# SAFETY_MODEL=nvidia_nim/nvidia/llama-3.1-nemotron-safety-guard-8b-v3

# Vision model for the see_image tool (optional): overrides the routing 'vision' pick.
# Must accept image input via LiteLLM (e.g. a multimodal NIM model).
# VISION_MODEL=nvidia_nim/meta/llama-4-maverick-17b-128e-instruct

# Off-site backups (optional): a command to push each backup zip somewhere durable
# ({zip} = the archive path). Run `python scripts/backup.py --keep 14` from OS cron.
# BACKUP_UPLOAD_CMD=rclone copy {zip} gdrive:agentcore-backups

# See docs/PLACEHOLDERS.md for the full checklist of optional inputs.
